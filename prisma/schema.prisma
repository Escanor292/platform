generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  password        String?
  name            String
  displayName     String?
  avatar          String?
  phone           String?
  role            UserRole          @default(BACKER)
  isPro           Boolean           @default(false)
  isOrganization  Boolean           @default(false)
  isAdmin         Boolean           @default(false)
  bio             String?
  idCard          String?
  businessLicense String?
  bankAccount     String?
  bankName        String?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  campaigns       Campaign[]
  invoices        PlatformInvoice[]
  pledges         Pledge[]
  reviews         Review[]

  @@map("users")
}

model Campaign {
  id              String            @id @default(cuid())
  campaignCode    String            @unique
  slug            String            @unique
  title           String
  description     String
  longDescription String?
  videoUrl        String?
  imageUrl        String?
  type            CampaignType      @default(REWARD)
  category        String
  goalAmount      Decimal
  currentAmount   Decimal           @default(0)
  status          CampaignStatus    @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  creatorId       String
  feeRate         Float             @default(0.08)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  updates         CampaignUpdate[]
  creator         User              @relation(fields: [creatorId], references: [id])
  invoices        PlatformInvoice[]
  pledges         Pledge[]
  Review          Review[]
  rewards         Reward[]

  @@map("campaigns")
}

model Reward {
  id          String   @id @default(cuid())
  campaignId  String
  title       String
  description String
  amount      Decimal
  quantity    Int?
  remaining   Int?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id])

  @@map("rewards")
}

model Pledge {
  id               String       @id @default(cuid())
  campaignId       String
  userId           String?
  displayName      String
  isAnonymous      Boolean      @default(false)
  email            String?
  phoneNumber      String?
  amount           Decimal
  tipAmount        Decimal      @default(0)
  platformFee      Decimal      @default(0)
  vatAmount        Decimal      @default(0)
  totalAmount      Decimal
  paymentProvider  String
  transactionId    String       @unique
  ipAddress        String?
  deviceInfo       Json?
  status           PledgeStatus @default(PENDING)
  refundStatus     RefundStatus @default(NO_REFUND)
  refundedAt       DateTime?
  invoiceGroupDate DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  campaign         Campaign     @relation(fields: [campaignId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])

  @@map("pledges")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  content    String
  imageUrl   String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@map("campaign_updates")
}

model Review {
  id         String    @id @default(cuid())
  userId     String
  campaignId String?
  rating     Int
  comment    String
  imageUrl   String?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model DailyTipInvoice {
  id          String   @id @default(cuid())
  invoiceDate DateTime @unique
  totalTip    Decimal
  totalVat    Decimal
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("daily_tip_invoices")
}

model PlatformInvoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  campaignId    String
  creatorId     String
  amount        Decimal
  vatAmount     Decimal
  totalAmount   Decimal
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  campaign      Campaign      @relation(fields: [campaignId], references: [id])
  creator       User          @relation(fields: [creatorId], references: [id])

  @@map("platform_invoices")
}

enum UserRole {
  BACKER
  CREATOR_PENDING
  CREATOR
  CREATOR_PRO
}

enum CampaignType {
  REWARD
  DONATION
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUCCESS
  FAILED
  CANCELED
}

enum PledgeStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  NO_REFUND
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}
