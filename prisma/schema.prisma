generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  password        String?
  name            String
  displayName     String?
  avatar          String?
  image           String?           // Avatar URL (for OAuth)
  coverImage      String?           // Ảnh bìa profile
  phone           String?
  shippingAddress String?           // Địa chỉ nhận hàng
  role            UserRole          @default(BACKER)
  status          UserStatus        @default(NORMAL)
  isOrganization  Boolean           @default(false)
  isAdmin         Boolean           @default(false)
  bio             String?
  location        String?           // Địa điểm
  website         String?           // Website cá nhân
  socialLinks     Json?             // Social media links array
  idCard          String?
  businessLicense String?
  bankAccount     String?
  bankName        String?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  campaigns       Campaign[]
  invoices        PlatformInvoice[]
  pledges         Pledge[]
  reviews         Review[]
  kycInfo         KYCInfo?
  auditLogs       AuditLog[]
  followedCampaigns CampaignFollower[]
  reports         CampaignReport[]

  @@map("users")
}

model Campaign {
  id              String            @id @default(cuid())
  campaignCode    String            @unique
  slug            String            @unique
  title           String
  description     String
  longDescription String?
  videoUrl        String?
  imageUrl        String?
  images          String[]          @default([]) // Multiple images for campaign
  type            CampaignType      @default(REWARD)
  category        String
  tags            String[]          @default([]) // Starter tags for taxonomy
  goalAmount      Decimal
  currentAmount   Decimal           @default(0)
  status          CampaignStatus    @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  creatorId       String
  feeRate         Float             @default(0.08)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  updates         CampaignUpdate[]
  creator         User              @relation(fields: [creatorId], references: [id])
  invoices        PlatformInvoice[]
  pledges         Pledge[]
  Review          Review[]
  rewards         Reward[]
  followers       CampaignFollower[]
  reports         CampaignReport[]

  @@index([category])
  @@index([tags])
  @@map("campaigns")
}

model Reward {
  id           String    @id @default(cuid())
  campaignId   String
  title        String
  description  String?
  minAmount    Decimal   // Mức ủng hộ tối thiểu để nhận reward
  maxQuantity  Int?      // Số lượng giới hạn (null = không giới hạn)
  deliveryDate DateTime? // Ngày giao hàng dự kiến
  isActive     Boolean   @default(true) // Trạng thái hoạt động
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pledges      Pledge[]  // Các pledge chọn reward này

  @@index([campaignId])
  @@map("rewards")
}

model Pledge {
  id               String          @id @default(cuid())
  campaignId       String
  userId           String?
  rewardId         String?         // ID của reward được chọn
  displayName      String
  isAnonymous      Boolean         @default(false)
  email            String?
  phoneNumber      String?
  shippingAddress  String?         // Địa chỉ nhận hàng cho reward
  amount           Decimal
  tipAmount        Decimal         @default(0)
  platformFee      Decimal         @default(0)
  vatAmount        Decimal         @default(0)
  totalAmount      Decimal
  paymentProvider  String
  transactionId    String          @unique
  payosOrderCode   String?         @unique // OrderCode từ PayOS webhook
  ipAddress        String?
  deviceInfo       Json?
  status           PledgeStatus    @default(PENDING)
  refundStatus     RefundStatus    @default(NO_REFUND)
  refundedAt       DateTime?
  invoiceGroupDate DateTime?
  webhookProcessedAt DateTime?     // Thời gian webhook được xử lý (để check idempotency)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaign         Campaign        @relation(fields: [campaignId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  reward           Reward?         @relation(fields: [rewardId], references: [id])
  backerInvoice    BackerInvoice?
  auditLogs        AuditLog[]

  @@map("pledges")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  content    String
  imageUrl   String?
  tags       String[] @default([]) // Tags cho update
  isPinned   Boolean  @default(false) // Ghim update quan trọng
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, isPinned])
  @@index([tags])
  @@map("campaign_updates")
}

model Review {
  id         String    @id @default(cuid())
  userId     String
  campaignId String?
  rating     Int
  comment    String
  imageUrl   String?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ============================================================
// Campaign Report - Báo cáo chiến dịch (chỉ cho logged-in users)
// ============================================================
model CampaignReport {
  id          String              @id @default(cuid())
  campaignId  String
  userId      String              // Bắt buộc - chỉ logged-in users
  reason      CampaignReportReason
  description String              // Mô tả chi tiết
  status      ReportStatus        @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?             // Admin ID
  resolution  String?             // Kết luận
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId]) // Chỉ 1 report/user/campaign
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@map("campaign_reports")
}

// ============================================================
// Campaign Followers - Người quan tâm dự án
// ============================================================
model CampaignFollower {
  id         String   @id @default(cuid())
  campaignId String
  userId     String?  // null nếu anonymous
  email      String?  // Email cho anonymous users
  createdAt  DateTime @default(now())
  
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([campaignId, userId])
  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_followers")
}

model DailyTipInvoice {
  id          String   @id @default(cuid())
  invoiceDate DateTime @unique
  totalTip    Decimal
  totalVat    Decimal
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("daily_tip_invoices")
}

model PlatformInvoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  campaignId    String
  creatorId     String
  amount        Decimal
  vatAmount     Decimal
  totalAmount   Decimal
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  campaign      Campaign      @relation(fields: [campaignId], references: [id])
  creator       User          @relation(fields: [creatorId], references: [id])

  @@map("platform_invoices")
}

enum UserRole {
  ADMIN
  BACKER
  CREATOR_PENDING
  CREATOR
}

enum UserStatus {
  NORMAL
  PRO
  BANNED
}

enum CampaignType {
  REWARD
  DONATION
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUCCESS
  FAILED
  CANCELED
}

enum PledgeStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  NO_REFUND
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// KYC (Know Your Customer) - Xác minh danh tính
// ============================================================
model KYCInfo {
  id                String        @id @default(cuid())
  userId            String        @unique
  fullName          String        // Họ tên đầy đủ
  idCardNumber      String        @unique // Số CMND/CCCD/Passport
  idCardType        IDCardType    // Loại giấy tờ
  idCardFrontImage  String?       // Ảnh mặt trước
  idCardBackImage   String?       // Ảnh mặt sau
  idCardIssueDate   DateTime?     // Ngày cấp
  idCardIssuePlace  String?       // Nơi cấp
  dateOfBirth       DateTime?     // Ngày sinh
  placeOfBirth      String?       // Nơi sinh
  nationality       String        @default("VN") // Quốc tịch
  permanentAddress  String?       // Địa chỉ thường trú
  currentAddress    String?       // Địa chỉ hiện tại
  occupation        String?       // Nghề nghiệp
  monthlyIncome     String?       // Thu nhập hàng tháng
  verificationStatus KYCStatus    @default(PENDING)
  verifiedAt        DateTime?     // Thời gian xác minh
  verifiedBy        String?       // Người xác minh (admin ID)
  rejectedReason    String?       // Lý do từ chối
  riskLevel         RiskLevel     @default(LOW) // Mức độ rủi ro
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_info")
}

// ============================================================
// Hóa đơn cho Backer (Người ủng hộ)
// ============================================================
model BackerInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // Số hóa đơn: INV-YYYYMMDD-XXXXX
  pledgeId        String        @unique
  backerName      String        // Tên người ủng hộ
  backerEmail     String?       // Email
  backerPhone     String?       // Số điện thoại
  backerAddress   String?       // Địa chỉ (nếu yêu cầu)
  backerTaxCode   String?       // Mã số thuế (nếu là công ty)
  companyName     String?       // Tên công ty (nếu có)
  amount          Decimal       // Số tiền ủng hộ
  tipAmount       Decimal       // Tiền tip
  platformFee     Decimal       // Phí nền tảng
  vatAmount       Decimal       // VAT
  totalAmount     Decimal       // Tổng cộng
  campaignTitle   String        // Tên chiến dịch
  paymentMethod   String        // Phương thức thanh toán
  transactionId   String        // Mã giao dịch
  status          InvoiceStatus @default(PENDING)
  issuedAt        DateTime      @default(now()) // Ngày xuất hóa đơn
  pdfUrl          String?       // Link file PDF
  sentAt          DateTime?     // Thời gian gửi email
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pledge          Pledge        @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@map("backer_invoices")
}

// ============================================================
// Audit Log - Lịch sử thay đổi
// ============================================================
model AuditLog {
  id          String    @id @default(cuid())
  userId      String?   // Người thực hiện (null nếu system)
  action      AuditAction // Hành động
  entityType  String    // Loại entity: USER, CAMPAIGN, PLEDGE, INVOICE
  entityId    String    // ID của entity
  oldValue    Json?     // Giá trị cũ
  newValue    Json?     // Giá trị mới
  changes     Json?     // Chi tiết thay đổi
  ipAddress   String?   // IP address
  userAgent   String?   // User agent
  reason      String?   // Lý do thay đổi
  metadata    Json?     // Thông tin bổ sung
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  pledge      Pledge?   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Transaction Limit - Giới hạn giao dịch
// ============================================================
model TransactionLimit {
  id              String   @id @default(cuid())
  userId          String?  @unique // null = áp dụng cho tất cả
  kycStatus       KYCStatus? // Áp dụng cho KYC status nào
  maxPerTransaction Decimal // Giới hạn mỗi giao dịch
  maxPerDay       Decimal  // Giới hạn mỗi ngày
  maxPerMonth     Decimal  // Giới hạn mỗi tháng
  maxTransactionsPerDay Int // Số lần giao dịch tối đa/ngày
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("transaction_limits")
}

// ============================================================
// Blacklist - Danh sách đen
// ============================================================
model Blacklist {
  id          String        @id @default(cuid())
  type        BlacklistType // Loại: IP, EMAIL, PHONE, BANK_ACCOUNT
  value       String        // Giá trị bị chặn
  reason      String        // Lý do
  addedBy     String?       // Admin thêm vào
  isActive    Boolean       @default(true)
  expiresAt   DateTime?     // Thời gian hết hạn (null = vĩnh viễn)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([type, value])
  @@index([type, value, isActive])
  @@map("blacklist")
}

// ============================================================
// Enums mới
// ============================================================
enum IDCardType {
  CMND      // Chứng minh nhân dân
  CCCD      // Căn cước công dân
  PASSPORT  // Hộ chiếu
}

enum KYCStatus {
  PENDING   // Chờ xác minh
  VERIFIED  // Đã xác minh
  REJECTED  // Bị từ chối
  EXPIRED   // Hết hạn
}

enum RiskLevel {
  LOW       // Thấp
  MEDIUM    // Trung bình
  HIGH      // Cao
  CRITICAL  // Nghiêm trọng
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REFUND
  APPROVE
  REJECT
  CANCEL
  LOGIN
  LOGOUT
  KYC_SUBMIT
  KYC_APPROVE
  KYC_REJECT
}

enum BlacklistType {
  IP
  EMAIL
  PHONE
  BANK_ACCOUNT
  DEVICE_ID
}

enum CampaignReportReason {
  FRAUD              // Gian lận
  INAPPROPRIATE      // Nội dung không phù hợp
  MISLEADING         // Thông tin sai lệch
  SCAM               // Lừa đảo
  INTELLECTUAL_PROPERTY // Vi phạm bản quyền
  OTHER              // Khác
}

enum ReportStatus {
  PENDING    // Chờ xử lý
  REVIEWING  // Đang xem xét
  RESOLVED   // Đã giải quyết
  DISMISSED  // Bị bác bỏ
}
