{
  "name": "crowdfunding-vn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && node scripts/prisma-migrate-deploy.mjs && next build",
    "seed:test2": "tsx scripts/seed-test2-creator.ts",
    "clear:campaigns": "tsx scripts/clear-all-campaigns.ts",
    "clear:campaigns:seed": "tsx scripts/clear-campaigns-for-seed.ts",
    "seed:campaigns": "node seed-campaigns-comprehensive.js",
    "seed:campaigns:fresh": "npm run clear:campaigns:seed && npm run seed:campaigns",
    "seed:campaigns:reset": "prisma db push --skip-generate && node seed-campaigns-comprehensive.js",
    "test": "jest",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "jest __tests__/ui",
    "test:functional": "jest __tests__/functional",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "playwright test",
    "seed:e2e": "node scripts/seed-e2e-public-assistant.mjs",
    "test:report": "tsx __tests__/run-tests-and-report.ts",
    "test:all": "npm test && npm run test:db",
    "mongo:init": "node scripts/init-mongodb.js",
    "chat:init": "tsx scripts/init-chat-indexes.ts",
    "blog:init": "tsx scripts/init-blog-system.ts"
  },
