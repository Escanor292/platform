# ============================================================
# CrowdFund VN - Environment Variables Template
# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit file .env vào git!
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crowdfunding-vn"

# --- Redis Cache (Redis Cloud) ---
# Giao thức rediss:// bắt buộc TLS
REDIS_URL="rediss://default:password@host:port"


# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                     # Generate: openssl rand -base64 32

# --- Google OAuth (tùy chọn) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (upload ảnh) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Ngân hàng trung gian (giữ hộ đến khi chiến dịch kết thúc) ---
# Creator không kết nối PayOS/MoMo/VNPay. Chỉ khai STK nhận chi hộ.
ESCROW_BANK_NAME="Vietcombank"
ESCROW_BANK_BIN="970436"
ESCROW_ACCOUNT_NUMBER=""
ESCROW_ACCOUNT_HOLDER="CONG TY TUTE FUND"
ESCROW_BANK_BRANCH=""

# --- App URL (dùng cho webhook & redirect) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI-BS telemetry read-only (bắt buộc trùng với PLATFORM_TELEMETRY_READ_KEY ở AI-BS) ---
# Dùng chuỗi ngẫu nhiên tối thiểu 32 ký tự. Không đưa vào NEXT_PUBLIC_*
ASSISTANT_TELEMETRY_READ_KEY=""

# --- MongoDB (Parallel Integration) ---
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority"
MONGODB_DB_NAME="crowdfunding_vn"

# --- Feature Flags (MongoDB) ---
ENABLE_MONGO_LOGS=true
ENABLE_MONGO_NOTIFICATIONS=true
ENABLE_MONGO_COMMENTS=true
ENABLE_MONGO_ANALYTICS=true
ENABLE_MONGO_CAMPAIGN_CONTENT=true
ENABLE_MONGO_CAMPAIGN_UPDATES=true
ENABLE_MONGO_USER_METADATA=true
ENABLE_MONGO_CHAT=true

# --- Public grounded assistant (server-side only) ---
# Lấy từ Google AI Studio; tuyệt đối không dùng NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Route /api/public/assistant tự giới hạn câu hỏi/context/output, timeout và rate limit; lỗi 429 được trả về để UI fallback an toàn.
