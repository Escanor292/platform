# ============================================================
# CrowdFund VN - Environment Variables Template
# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit file .env vào git!
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crowdfunding-vn"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                     # Generate: openssl rand -base64 32

# --- Google OAuth (tùy chọn) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (upload ảnh) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- VNPay ---
VNP_TMN_CODE=""                        # Mã merchant từ VNPay sandbox
VNP_HASH_SECRET=""                     # Secret key từ VNPay

# --- MoMo (tùy chọn) ---
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# --- PayOS ---
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# --- App URL (dùng cho webhook & redirect) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
